{
    "$schema": "https://eks.engineering/schemas/eks_doc_setup_schema.json",
    "$id": "https://eks.engineering/configs/eks_doc_config_default.json",
    "version": "1.14.0",
    "title": "EKS Document Configuration",
    "description": "Document schema config v1.14.0 (I300 T1.263): §ontology_triggers extended 6→7 — added lifecycle_stage→HAS_STAGE (the 7th §B4.1 rule; verifies column_name PK stays 1:1 — document_number→SUPERSEDES and references_documents→REFERENCES_DOC remain distinct columns). v1.13.0 (I286 T1.237): column_processing marked manual_review:true on the 9 Manual-source columns (lifecycle_stage, revision_date, revision_description, project_phase, contract_package, issued_date, responsible_engineer, vendor_name, references_documents) per Appendix B §B4; added 4 review-workflow columns (department, status, security_class, verified_by) as non-calculated phase-B entries (scoring_tier excluded) so the schema-driven review allowlist retains the legacy 14 writable fields. v1.12.0 (I283 T1.230): element_type_registry extended 8→11 — added title_block, grid, signature_block entries with expected_by_cover_types for the four-level Class→Type→Template→Element detection model (element-set SSOT remains template expected_elements; registry entry is descriptive). v1.11.0 (I287 T1.241): REMOVED filename_profiles and file_property_patterns sections — consolidated into eks_processing_config.json (filename_profiles / file_property_profiles / os_properties top-level key) per I287 T1.238-240. REMOVED parser_class from file_type_registry rows — parser_class now single-sourced in eks_processing_config.json#/extraction_profiles[].parser_class (§16/§24, I287 T1.241). v1.9.0 (I279 T1.213-T1.216): removed committed document_type_registry and element_expectations — now derived at runtime from the three-section eks_document_type_schema.json v2.0.0 carrier; added document_type_schema_ref; added format_category to file_type_registry; added native parsing profiles (technip_dwg/technip_dgn/technip_xlsx — that satisfies GAP-N4). v1.8.0: added parsing_profiles section (technip_pdf, technip_docx) — parser profiles with capability fields per T1.195 V2. v1.7.0: moved revision_validation and filename_patterns to Project Definition (I265 T1.191). Added filename_profiles as reusable profile-keyed section (T1.191). v1.6.0: added column_processing object (DCC-aligned key-as-name pattern) with 42 column entries — Phase A (9): file_path, file_type, document_number, project_number, area, document_type, discipline, sequence_number, revision. Phase B (33): project_title, document_title, file_size, file_created_at, file_modified_at, file_hash, 9 embedded_* fields, page_count, created_by, checked_by, approved_by, originator_company, asset_tags, references_documents, language, vendor_name, total_sheets, lifecycle_stage, revision_description, revision_date, project_phase, contract_package, issued_date, responsible_engineer (I264, T1.184). v1.5.0: added DOCX embedded_revision_number mapping (T1.99.144) + references_documents ontology trigger (T1.99.145). v1.4.0: populated file_property_patterns with OS config + 5 file-type mappings (pdf/docx/xlsx/dgn/dwg) per Appendix J (T1.99.130). v1.3.0: added filename_patterns + file_property_patterns per Appendix I (T1.99.112). v1.10.0 (I281 T1.224): REMOVED parsing_profiles section — migrated to eks_processing_config.json#/extraction_profiles (one-time migration, Q1). Core processing config is the sole profile values SSOT.",
    "ontology_triggers": {
        "document_type": "IS_A",
        "document_number": "SUPERSEDES",
        "asset_tags": "REFERENCES_ASSET",
        "originator_company": "PRODUCED_BY",
        "file_type": "HAS_FORMAT",
        "references_documents": "REFERENCES_DOC",
        "lifecycle_stage": "HAS_STAGE"
    },
    "document_title_config": {
        "boilerplate_prefixes": ["Microsoft Word", "AutoCAD Drawing", "Microsoft Excel"],
        "description": "Embedded titles starting with these prefixes are treated as boilerplate and discarded in favor of filename-derived titles."
    },
    "health_scoring": {
        "dimensions": [
            { "name": "completeness", "weight": 0.20 },
            { "name": "extraction_confidence", "weight": 0.20 },
            { "name": "structural_completeness", "weight": 0.20 },
            { "name": "source_quality", "weight": 0.15 },
            { "name": "xref_quality", "weight": 0.15 },
            { "name": "consistency", "weight": 0.10 }
        ],
        "score_tiers": [
            { "min_score": 0.90, "max_score": 1.00, "status": "success", "action": "auto_register" },
            { "min_score": 0.70, "max_score": 0.89, "status": "success", "action": "optional_review" },
            { "min_score": 0.50, "max_score": 0.69, "status": "partial", "action": "flag_review" },
            { "min_score": 0.20, "max_score": 0.49, "status": "partial", "action": "mandatory_review" },
            { "min_score": 0.00, "max_score": 0.19, "status": "failed", "action": "manual_entry" }
        ],
        "weight_tiers": {
            "tier1_critical": 2.0,
            "tier2_standard": 1.0,
            "tier3_optional": 0.5
        },
        "default_source_quality_scores": {
            "A": 1.0,
            "B": 0.7,
            "C": 0.3,
            "D": 0.9,
            "E": 0.8,
            "F": 0.0
        }
    },
    "document_type_schema_ref": "https://eks.engineering/schemas/eks_document_type_schema.json",
    "file_type_registry": [
        { "extension": "pdf",  "display_name": "PDF Document",    "description": "Portable Document Format",  "mime_type": "application/pdf", "format_category": "print" },
        { "extension": "dgn",  "display_name": "DGN Drawing",     "description": "MicroStation DGN CAD Drawing", "mime_type": "image/vnd.dgn", "format_category": "native" },
        { "extension": "docx", "display_name": "Word Document",   "description": "Microsoft Word Document",   "mime_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "format_category": "native" },
        { "extension": "xlsx", "display_name": "Excel Workbook",  "description": "Microsoft Excel Workbook",  "mime_type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "format_category": "native" },
        { "extension": "dwg",  "display_name": "AutoCAD Drawing", "description": "AutoCAD Drawing",           "mime_type": "image/vnd.dwg", "format_category": "native" }
    ],
    "element_type_registry": [
        { "element_type": "cover_page",     "description": "Cover page fields from page 1",                                                "source_method": "regex",     "phase_2_use": "Section anchor",   "phase_3_use": "Document-type node",    "expected_by_cover_types": ["A", "B", "D", "E"] },
        { "element_type": "revision_table", "description": "Revision history table from page 1",                                         "source_method": "table",     "phase_2_use": "Change tracking",  "phase_3_use": "Revision nodes",        "expected_by_cover_types": ["A", "B"] },
        { "element_type": "section",        "description": "Section heading (regex \\d+\\.\\d+)",                                        "source_method": "regex",     "phase_2_use": "Chunk boundary",   "phase_3_use": "Section nodes",         "expected_by_cover_types": ["A", "B", "D", "E"] },
        { "element_type": "table",          "description": "Data table on page",                                                        "source_method": "heuristic", "phase_2_use": "Context chunks",   "phase_3_use": "Table nodes",           "expected_by_cover_types": ["E"] },
        { "element_type": "image",          "description": "Image/chart on page",                                                       "source_method": "heuristic", "phase_2_use": "Skip",             "phase_3_use": "Figure nodes",          "expected_by_cover_types": ["A", "B"] },
        { "element_type": "link",           "description": "URL or file path reference",                                                "source_method": "regex",     "phase_2_use": "Skip",             "phase_3_use": "Reference edges",       "expected_by_cover_types": ["A", "B", "C", "D", "E"] },
        { "element_type": "legend",         "description": "Page legend/symbol key",                                                    "source_method": "heuristic", "phase_2_use": "Skip",             "phase_3_use": "Legend nodes",          "expected_by_cover_types": ["A", "B"] },
        { "element_type": "note",           "description": "Page 1 annotation block",                                                   "source_method": "heuristic", "phase_2_use": "Skip",             "phase_3_use": "Annotation nodes",      "expected_by_cover_types": ["A", "B"] },
        { "element_type": "title_block",    "description": "Drawing title block (title/scale/drawn-by fields)",                           "source_method": "regex",     "phase_2_use": "Drawing frame",  "phase_3_use": "Title block nodes",     "expected_by_cover_types": ["A", "B", "D", "E"] },
        { "element_type": "grid",           "description": "Drawing grid coordinate references (e.g. A1, B4)",                          "source_method": "regex",     "phase_2_use": "Drawing frame",  "phase_3_use": "Grid reference nodes",  "expected_by_cover_types": ["A", "B"] },
        { "element_type": "signature_block","description": "Signature/approval block (drawn/checked/approved by)",                      "source_method": "regex",     "phase_2_use": "Drawing frame",  "phase_3_use": "Signature nodes",       "expected_by_cover_types": ["A", "B"] }
    ],
    "column_processing": {
        "file_path": {"column_type": "file_path_column", "is_calculated": false, "processing_phase": "A", "required": true, "scoring_tier": "excluded", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Relative path to source file on disk, populated by scanner discovery."},
        "file_type": {"column_type": "text_column", "is_calculated": false, "processing_phase": "A", "required": true, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "validation": [{"type": "format", "format": "file_extension"}], "description": "Source file format extension for parser routing."},
        "document_number": {"column_type": "code_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": 0, "separator": "-", "maps_to": "document_number"}, "processing_phase": "A", "required": true, "scoring_tier": "tier1", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Rejoined filename segments forming the unique document identifier."},
        "project_number": {"column_type": "code_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": 0, "separator": "-", "maps_to": "project_number"}, "processing_phase": "A", "required": true, "scoring_tier": "tier1", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "validation": [{"type": "pattern", "pattern": "^\\\\d{6}$"}], "description": "Project code from filename segment 0."},
        "area": {"column_type": "text_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": 1, "separator": "-", "maps_to": "area"}, "processing_phase": "A", "required": false, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Register", "Report", "Procedure"], "validation": [{"type": "pattern", "pattern": "^[A-Z0-9]{3,6}$"}], "description": "Contract or area code from filename segment 1."},
        "document_type": {"column_type": "code_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": 2, "separator": "-", "maps_to": "document_type"}, "processing_phase": "A", "required": true, "scoring_tier": "tier1", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "schema_ref": "document_type_registry", "schema_ref_field": "code", "validation": [{"type": "schema_reference_check", "reference": "document_type_registry", "data_section": "document_type_registry", "field": "code"}], "description": "Document type code from filename segment 2, validated against document_type_registry."},
        "discipline": {"column_type": "code_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": 3, "separator": "-", "maps_to": "discipline"}, "processing_phase": "A", "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Register", "Report", "Procedure"], "validation": [{"type": "pattern", "pattern": "^[A-Z]{1,2}$"}], "description": "Discipline code from filename segment 3."},
        "sequence_number": {"column_type": "sequence_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": 4, "separator": "-", "maps_to": "sequence_number"}, "processing_phase": "A", "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "validation": [{"type": "pattern", "pattern": "^\\\\d{4}$"}], "description": "Sequence number from filename segment 4."},
        "revision": {"column_type": "revision_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": null, "separator": "_rev", "maps_to": "revision"}, "processing_phase": "A", "required": true, "scoring_tier": "tier1", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Revision identifier detected from filename suffix or revision separators."},
        "project_title": {"column_type": "text_column", "is_calculated": true, "calculation": {"type": "priority_chain", "sources": [{"source": "cover_page_element", "field": "project_title"}, {"source": "parser_metadata", "field": "project_title"}, {"source": "code_to_title_lookup", "field": "project_number"}], "fallback": "leave_null"}, "processing_phase": "B", "required": false, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Project title resolved via priority chain: cover page > parser metadata > code-to-title lookup."},
        "document_title": {"column_type": "text_column", "is_calculated": true, "calculation": {"type": "priority_chain", "sources": [{"source": "parser_metadata", "field": "embedded_title"}, {"source": "file_property", "field": "filename_stem"}], "fallback": "leave_null"}, "processing_phase": "B", "required": false, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Human-readable document title derived from embedded title or filename stem."},
        "file_size": {"column_type": "numeric_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "OS-level file size in bytes from FilePropertyExtractor."},
        "file_created_at": {"column_type": "date_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "OS-level file creation timestamp from FilePropertyExtractor."},
        "file_modified_at": {"column_type": "date_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "OS-level file last-modified timestamp from FilePropertyExtractor."},
        "file_hash": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "excluded", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Content hash for integrity verification from FilePropertyExtractor."},
        "embedded_title": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Embedded document title from parser metadata (native formats only — PDF prints carry none)."},
        "embedded_subject": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Embedded document subject from parser metadata (native-only)."},
        "embedded_created_date": {"column_type": "date_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Embedded creation date from parser metadata (native-only)."},
        "embedded_modified_date": {"column_type": "date_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Embedded modification date from parser metadata (native-only)."},
        "embedded_creator_app": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Application that created the file from parser metadata (native-only)."},
        "embedded_producer": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Library/producer that generated the file from parser metadata (native-only)."},
        "embedded_last_modified_by": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Last user who modified the file from DOCX/XLSX core properties (native-only)."},
        "embedded_keywords": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Embedded keywords from parser metadata (native-only)."},
        "embedded_sheet_count": {"column_type": "numeric_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "required": true, "scoring_tier": "tier1", "applies_to_document_types": ["Datasheet", "Register"], "description": "Number of sheets in XLSX workbook from parser metadata (native-only). I284: tier1 critical for Datasheet/Register."},
        "embedded_revision_number": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Revision number from embedded DOCX/XLSX core properties (native-only)."},
        "page_count": {"column_type": "numeric_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Page count from parser metadata."},
        "created_by": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Author/creator from parser metadata."},
        "checked_by": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Last checker from parser metadata or cover page."},
        "approved_by": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Last approver from parser metadata or cover page."},
        "originator_company": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "Originating company from parser metadata or cover page."},
        "asset_tags": {"column_type": "json_column", "is_calculated": true, "calculation": {"type": "cover_page_element", "field": "asset_tags"}, "processing_phase": "B", "required": false, "scoring_tier": "tier1", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "validation": [{"type": "min_length", "min_length": 0}], "description": "Asset tag list extracted from cover page content, comma-split to JSON array."},
        "references_documents": {"column_type": "json_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "manual_review": true, "description": "Array of document IDs this document references, from content parser. I286: Manual-source (B4)."},
        "language": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "description": "ISO 639-1 language code of document content. Default: en."},
        "vendor_name": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Datasheet", "Manual", "Specification", "Calculation", "Report", "Procedure"], "manual_review": true, "description": "Equipment vendor name for vendor-supplied documents. I286: Manual-source (B4)."},
        "total_sheets": {"column_type": "numeric_column", "is_calculated": true, "calculation": {"type": "priority_chain", "sources": [{"source": "parser_metadata", "field": "total_sheets"}, {"source": "parser_metadata", "field": "page_count"}], "fallback": "leave_null"}, "processing_phase": "B", "required": false, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing"], "description": "Total sheets in multi-sheet drawing set. I275 scoped to Drawing class (datasheets store per-row count, not total_sheets). Defaults to page_count when not explicit."},
        "lifecycle_stage": {"column_type": "code_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "schema_ref": "lifecycle_stage_code", "validation": [{"type": "enum_reference", "reference": "lifecycle_stage_code", "field": "code"}], "manual_review": true, "description": "Document lifecycle stage from cover page or parser metadata. I286: Manual-source (B4), enum-validated."},
        "revision_description": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier3", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "manual_review": true, "description": "Description of changes in this revision from revision table element. I286: Manual-source (B4)."},
        "revision_date": {"column_type": "date_column", "is_calculated": false, "processing_phase": "B", "required": false, "scoring_tier": "tier2", "applies_to_document_types": ["Drawing", "Specification", "Datasheet", "Calculation", "Manual", "Register", "Report", "Procedure"], "manual_review": true, "description": "Date of this revision from revision table or parser metadata. I286: Manual-source (B4), ISO-date-validated."},
