{
    "$schema": "https://eks.engineering/schemas/eks_doc_setup_schema.json",
    "$id": "https://eks.engineering/configs/eks_doc_config_default.json",
    "version": "1.9.0",
    "title": "EKS Document Configuration",
    "description": "Document schema config v1.9.0 (I279 T1.213-T1.216): removed committed document_type_registry and element_expectations — now derived at runtime from the three-section eks_document_type_schema.json v2.0.0 carrier; added document_type_schema_ref; added format_category to file_type_registry; added native parsing profiles (technip_dwg/technip_dgn/technip_xlsx — that satisfies GAP-N4). v1.8.0: added parsing_profiles section (technip_pdf, technip_docx) — parser profiles with capability fields per T1.195 V2. v1.7.0: moved revision_validation and filename_patterns to Project Definition (I265 T1.191). Added filename_profiles as reusable profile-keyed section (T1.191). v1.6.0: added column_processing object (DCC-aligned key-as-name pattern) with 42 column entries — Phase A (9): file_path, file_type, document_number, project_number, area, document_type, discipline, sequence_number, revision. Phase B (33): project_title, document_title, file_size, file_created_at, file_modified_at, file_hash, 9 embedded_* fields, page_count, created_by, checked_by, approved_by, originator_company, asset_tags, references_documents, language, vendor_name, total_sheets, lifecycle_stage, revision_description, revision_date, project_phase, contract_package, issued_date, responsible_engineer (I264, T1.184). v1.5.0: added DOCX embedded_revision_number mapping (T1.99.144) + references_documents ontology trigger (T1.99.145). v1.4.0: populated file_property_patterns with OS config + 5 file-type mappings (pdf/docx/xlsx/dgn/dwg) per Appendix J (T1.99.130). v1.3.0: added filename_patterns + file_property_patterns per Appendix I (T1.99.112).",
    "ontology_triggers": {
        "document_type": "IS_A",
        "document_number": "SUPERSEDES",
        "asset_tags": "REFERENCES_ASSET",
        "originator_company": "PRODUCED_BY",
        "file_type": "HAS_FORMAT",
        "references_documents": "REFERENCES_DOC"
    },
    "document_title_config": {
        "boilerplate_prefixes": ["Microsoft Word", "AutoCAD Drawing", "Microsoft Excel"],
        "description": "Embedded titles starting with these prefixes are treated as boilerplate and discarded in favor of filename-derived titles."
    },
    "health_scoring": {
        "dimensions": [
            { "name": "completeness", "weight": 0.20 },
            { "name": "extraction_confidence", "weight": 0.20 },
            { "name": "structural_completeness", "weight": 0.20 },
            { "name": "source_quality", "weight": 0.15 },
            { "name": "xref_quality", "weight": 0.15 },
            { "name": "consistency", "weight": 0.10 }
        ],
        "score_tiers": [
            { "min_score": 0.90, "max_score": 1.00, "status": "success", "action": "auto_register" },
            { "min_score": 0.70, "max_score": 0.89, "status": "success", "action": "optional_review" },
            { "min_score": 0.50, "max_score": 0.69, "status": "partial", "action": "flag_review" },
            { "min_score": 0.20, "max_score": 0.49, "status": "partial", "action": "mandatory_review" },
            { "min_score": 0.00, "max_score": 0.19, "status": "failed", "action": "manual_entry" }
        ],
        "weight_tiers": {
            "tier1_critical": 2.0,
            "tier2_standard": 1.0,
            "tier3_optional": 0.5
        }
    },
    "document_type_schema_ref": "https://eks.engineering/schemas/eks_document_type_schema.json",
    "file_type_registry": [
        { "extension": "pdf",  "display_name": "PDF Document",   "parser_class": "eks.engine.parsers.pdf_parser.PDFParser",    "description": "Portable Document Format",  "mime_type": "application/pdf", "format_category": "print" },
        { "extension": "dgn",  "display_name": "DGN Drawing",    "parser_class": "eks.engine.parsers.dgn_parser.DGNParserStub", "description": "MicroStation DGN CAD Drawing", "mime_type": "image/vnd.dgn", "format_category": "native" },
        { "extension": "docx", "display_name": "Word Document",  "parser_class": "eks.engine.parsers.docx_parser.DOCXParser",  "description": "Microsoft Word Document",   "mime_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "format_category": "native" },
        { "extension": "xlsx", "display_name": "Excel Workbook", "parser_class": "eks.engine.parsers.xlsx_parser.XLSXParser",  "description": "Microsoft Excel Workbook",  "mime_type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "format_category": "native" },
        { "extension": "dwg",  "display_name": "AutoCAD Drawing","parser_class": "eks.engine.parsers.dwg_parser.DWGParserStub", "description": "AutoCAD Drawing",           "mime_type": "image/vnd.dwg", "format_category": "native" }
    ],
    "element_type_registry": [
        { "element_type": "cover_page",     "description": "Cover page fields from page 1",                                                "source_method": "regex",     "phase_2_use": "Section anchor",   "phase_3_use": "Document-type node",    "expected_by_cover_types": ["A", "B", "D", "E"] },
        { "element_type": "revision_table", "description": "Revision history table from page 1",                                         "source_method": "table",     "phase_2_use": "Change tracking",  "phase_3_use": "Revision nodes",        "expected_by_cover_types": ["A", "B"] },
        { "element_type": "section",        "description": "Section heading (regex \\d+\\.\\d+)",                                        "source_method": "regex",     "phase_2_use": "Chunk boundary",   "phase_3_use": "Section nodes",         "expected_by_cover_types": ["A", "B", "D", "E"] },
        { "element_type": "table",          "description": "Data table on page",                                                        "source_method": "heuristic", "phase_2_use": "Context chunks",   "phase_3_use": "Table nodes",           "expected_by_cover_types": ["E"] },
        { "element_type": "image",          "description": "Image/chart on page",                                                       "source_method": "heuristic", "phase_2_use": "Skip",             "phase_3_use": "Figure nodes",          "expected_by_cover_types": ["A", "B"] },
        { "element_type": "link",           "description": "URL or file path reference",                                                "source_method": "regex",     "phase_2_use": "Skip",             "phase_3_use": "Reference edges",       "expected_by_cover_types": ["A", "B", "C", "D", "E"] },
        { "element_type": "legend",         "description": "Page legend/symbol key",                                                    "source_method": "heuristic", "phase_2_use": "Skip",             "phase_3_use": "Legend nodes",          "expected_by_cover_types": ["A", "B"] },
        { "element_type": "note",           "description": "Page 1 annotation block",                                                   "source_method": "heuristic", "phase_2_use": "Skip",             "phase_3_use": "Annotation nodes",      "expected_by_cover_types": ["A", "B"] }
    ],
    "filename_profiles": {
        "twrp_standard": {
            "description": "TWRP WSD11 tenderspec naming: {project}-{area}-{type}-{disc}-{seq}[_suffix].ext",
            "parser_type": "delimited",
            "separator": "-",
            "min_segments": 5,
            "max_segments": 5,
            "segments": [
                { "position": 0, "maps_to": "project_number", "label": "project_code", "required": true, "null_handling": { "strategy": "default_value", "default_value": "131101" }, "validation": { "type": "pattern", "pattern": "^\\d{6}$" } },
                { "position": 1, "maps_to": "area", "label": "contract_or_area", "required": true, "null_handling": { "strategy": "default_value", "default_value": "UNKNOWN" }, "validation": { "type": "pattern", "pattern": "^[A-Z0-9]{3,6}$" } },
                { "position": 2, "maps_to": "document_type", "label": "type_code", "required": true, "null_handling": { "strategy": "default_value", "default_value": "UNKNOWN" }, "validation": { "type": "schema_reference", "reference": "document_type_registry" } },
                { "position": 3, "maps_to": "discipline", "label": "discipline_code", "required": true, "null_handling": { "strategy": "default_value", "default_value": "UNKNOWN" }, "validation": { "type": "pattern", "pattern": "^[A-Z]{1,2}$" } },
                { "position": 4, "maps_to": null, "label": "sequence_number", "required": true, "null_handling": { "strategy": "default_value", "default_value": "0000" }, "validation": { "type": "pattern", "pattern": "^\\d{4}$" } }
            ],
            "rejoin_separator": "-",
            "strip_suffixes": ["_Add1", "_Add2", "_Add3", "_2-Stage", "_2-stage", "_HAC"],
            "revision_separators": ["_rev"],
            "dash_revision_max_len": 3,
            "output": { "document_number_source": "rejoin_segments", "fallback_doc_number": "full_stem", "fallback_revision": null, "preservation_mode": "overwrite_existing" },
            "error_subcodes": { "too_few_segments": "P5-F-V-0004", "too_many_segments": "P5-F-V-0005", "segment_validation_failed": "P5-F-V-0006", "unresolvable": "P5-F-P-0007" },
            "processing_phase": "P0"
        },
        "default": {
            "description": "Generic dash-suffix revision detection (backward compatible)",
            "parser_type": "delimited",
            "separator": "-",
            "min_segments": 1,
            "max_segments": null,
            "segments": [],
            "rejoin_separator": "-",
            "strip_suffixes": [],
            "revision_separators": ["_rev"],
            "dash_revision_max_len": 3,
            "output": { "document_number_source": "rejoin_segments", "fallback_doc_number": "full_stem", "fallback_revision": "00", "preservation_mode": "overwrite_existing" },
            "error_subcodes": {},
            "processing_phase": "P0"
        }
    },
    "parsing_profiles": {
        "technip_pdf": {
            "profile_id": "technip_pdf",
            "parser_class": "eks.engine.parsers.pdf_parser.PDFParser",
            "description": "TWRP PDF document parser (cover page + metadata extraction)",
            "supported_extensions": ["pdf"],
            "supported_document_profiles": ["twrp_standard"],
            "requires_ocr": false,
            "extraction_methods": ["parser_metadata", "cover_page_element"]
        },
        "technip_docx": {
            "profile_id": "technip_docx",
            "parser_class": "eks.engine.parsers.docx_parser.DOCXParser",
            "description": "TWRP Word document parser (embedded metadata extraction)",
            "supported_extensions": ["docx"],
            "supported_document_profiles": ["twrp_standard"],
            "requires_ocr": false,
            "extraction_methods": ["parser_metadata"]
        },
        "technip_dwg": {
            "profile_id": "technip_dwg",
            "parser_class": "eks.engine.parsers.dwg_parser.DWGParserStub",
            "description": "TWRP native DWG drawing reader (I279 T1.215 — GAP-N4)",
            "supported_extensions": ["dwg"],
            "supported_document_profiles": ["twrp_standard"],
            "requires_ocr": false,
            "extraction_methods": ["parser_metadata"]
        },
        "technip_dgn": {
            "profile_id": "technip_dgn",
            "parser_class": "eks.engine.parsers.dgn_parser.DGNParserStub",
            "description": "TWRP native DGN drawing reader (I279 T1.215 — GAP-N4)",
            "supported_extensions": ["dgn"],
            "supported_document_profiles": ["twrp_standard"],
            "requires_ocr": false,
            "extraction_methods": ["parser_metadata"]
        },
        "technip_xlsx": {
            "profile_id": "technip_xlsx",
            "parser_class": "eks.engine.parsers.xlsx_parser.XLSXParser",
            "description": "TWRP native XLSX workbook reader (I279 T1.215 — GAP-N4)",
            "supported_extensions": ["xlsx"],
            "supported_document_profiles": ["twrp_standard"],
            "requires_ocr": false,
            "extraction_methods": ["parser_metadata"]
        }
    },
    "file_property_patterns": {
        "os_properties": {
            "enabled": true,
            "collect": ["file_size", "fs_created", "fs_modified", "file_hash"],
            "hash_algorithm": "md5"
        },
        "by_file_type": {
            "pdf": {
                "enabled": true,
                "extraction_method": "parser_metadata",
                "property_mapping": [
                    { "source_key": "author", "maps_to": "created_by", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "title", "maps_to": "embedded_title", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "subject", "maps_to": "embedded_subject", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "creator", "maps_to": "embedded_creator_app", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "producer", "maps_to": "embedded_producer", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "creation_date", "maps_to": "embedded_created_date", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "mod_date", "maps_to": "embedded_modified_date", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "page_count", "maps_to": "page_count", "null_handling": { "strategy": "default_value", "default_value": 0 }, "required": false },
                    { "source_key": "keywords", "maps_to": "embedded_keywords", "null_handling": { "strategy": "skip" }, "required": false }
                ]
            },
            "docx": {
                "enabled": true,
                "extraction_method": "parser_metadata",
                "property_mapping": [
                    { "source_key": "author", "maps_to": "created_by", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "title", "maps_to": "embedded_title", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "subject", "maps_to": "embedded_subject", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "created", "maps_to": "embedded_created_date", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "modified", "maps_to": "embedded_modified_date", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "last_modified_by", "maps_to": "embedded_last_modified_by", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "revision", "maps_to": "embedded_revision_number", "null_handling": { "strategy": "skip" }, "required": false }
                ]
            },
            "xlsx": {
                "enabled": true,
                "extraction_method": "parser_metadata",
                "property_mapping": [
                    { "source_key": "author", "maps_to": "created_by", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "title", "maps_to": "embedded_title", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "subject", "maps_to": "embedded_subject", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "created", "maps_to": "embedded_created_date", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "modified", "maps_to": "embedded_modified_date", "null_handling": { "strategy": "skip" }, "required": false },
                    { "source_key": "sheet_count", "maps_to": "embedded_sheet_count", "null_handling": { "strategy": "default_value", "default_value": 0 }, "required": false },
                    { "source_key": "last_modified_by", "maps_to": "embedded_last_modified_by", "null_handling": { "strategy": "skip" }, "required": false }
                ]
            },
            "dgn": {
                "enabled": true,
                "extraction_method": "os_only",
                "property_mapping": []
            },
            "dwg": {
                "enabled": true,
                "extraction_method": "os_only",
                "property_mapping": []
            }
        }
    },
    "column_processing": {
        "file_path": {"column_type": "file_path_column", "is_calculated": false, "processing_phase": "A", "required": true, "description": "Relative path to source file on disk, populated by scanner discovery."},
        "file_type": {"column_type": "text_column", "is_calculated": false, "processing_phase": "A", "required": true, "validation": [{"type": "format", "format": "file_extension"}], "description": "Source file format extension for parser routing."},
        "document_number": {"column_type": "code_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": 0, "separator": "-", "maps_to": "document_number"}, "processing_phase": "A", "required": true, "description": "Rejoined filename segments forming the unique document identifier."},
        "project_number": {"column_type": "code_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": 0, "separator": "-", "maps_to": "project_number"}, "processing_phase": "A", "required": true, "validation": [{"type": "pattern", "pattern": "^\\\\d{6}$"}], "description": "Project code from filename segment 0."},
        "area": {"column_type": "text_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": 1, "separator": "-", "maps_to": "area"}, "processing_phase": "A", "validation": [{"type": "pattern", "pattern": "^[A-Z0-9]{3,6}$"}], "description": "Contract or area code from filename segment 1."},
        "document_type": {"column_type": "code_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": 2, "separator": "-", "maps_to": "document_type"}, "processing_phase": "A", "required": true, "schema_ref": "document_type_registry", "schema_ref_field": "code", "validation": [{"type": "schema_reference_check", "reference": "document_type_registry", "data_section": "document_type_registry", "field": "code"}], "description": "Document type code from filename segment 2, validated against document_type_registry."},
        "discipline": {"column_type": "code_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": 3, "separator": "-", "maps_to": "discipline"}, "processing_phase": "A", "validation": [{"type": "pattern", "pattern": "^[A-Z]{1,2}$"}], "description": "Discipline code from filename segment 3."},
        "sequence_number": {"column_type": "sequence_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": 4, "separator": "-", "maps_to": "sequence_number"}, "processing_phase": "A", "validation": [{"type": "pattern", "pattern": "^\\\\d{4}$"}], "description": "Sequence number from filename segment 4."},
        "revision": {"column_type": "revision_column", "is_calculated": true, "calculation": {"type": "filename_segment", "position": null, "separator": "_rev", "maps_to": "revision"}, "processing_phase": "A", "required": true, "description": "Revision identifier detected from filename suffix or revision separators."},
        "project_title": {"column_type": "text_column", "is_calculated": true, "calculation": {"type": "priority_chain", "sources": [{"source": "cover_page_element", "field": "project_title"}, {"source": "parser_metadata", "field": "project_title"}, {"source": "code_to_title_lookup", "field": "project_number"}], "fallback": "leave_null"}, "processing_phase": "B", "description": "Project title resolved via priority chain: cover page > parser metadata > code-to-title lookup."},
        "document_title": {"column_type": "text_column", "is_calculated": true, "calculation": {"type": "priority_chain", "sources": [{"source": "parser_metadata", "field": "embedded_title"}, {"source": "file_property", "field": "filename_stem"}], "fallback": "leave_null"}, "processing_phase": "B", "description": "Human-readable document title derived from embedded title or filename stem."},
        "file_size": {"column_type": "numeric_column", "is_calculated": false, "processing_phase": "B", "description": "OS-level file size in bytes from FilePropertyExtractor."},
        "file_created_at": {"column_type": "date_column", "is_calculated": false, "processing_phase": "B", "description": "OS-level file creation timestamp from FilePropertyExtractor."},
        "file_modified_at": {"column_type": "date_column", "is_calculated": false, "processing_phase": "B", "description": "OS-level file last-modified timestamp from FilePropertyExtractor."},
        "file_hash": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "description": "Content hash for integrity verification from FilePropertyExtractor."},
        "embedded_title": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "description": "Embedded document title from parser metadata (native formats only — PDF prints carry none)."},
        "embedded_subject": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "description": "Embedded document subject from parser metadata (native-only)."},
        "embedded_created_date": {"column_type": "date_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "description": "Embedded creation date from parser metadata (native-only)."},
        "embedded_modified_date": {"column_type": "date_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "description": "Embedded modification date from parser metadata (native-only)."},
        "embedded_creator_app": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "description": "Application that created the file from parser metadata (native-only)."},
        "embedded_producer": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "description": "Library/producer that generated the file from parser metadata (native-only)."},
        "embedded_last_modified_by": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "description": "Last user who modified the file from DOCX/XLSX core properties (native-only)."},
        "embedded_keywords": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "description": "Embedded keywords from parser metadata (native-only)."},
        "embedded_sheet_count": {"column_type": "numeric_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "description": "Number of sheets in XLSX workbook from parser metadata (native-only)."},
        "embedded_revision_number": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "native_only": true, "description": "Revision number from embedded DOCX/XLSX core properties (native-only)."},
        "page_count": {"column_type": "numeric_column", "is_calculated": false, "processing_phase": "B", "description": "Page count from parser metadata."},
        "created_by": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "description": "Author/creator from parser metadata."},
        "checked_by": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "description": "Last checker from parser metadata or cover page."},
        "approved_by": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "description": "Last approver from parser metadata or cover page."},
        "originator_company": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "description": "Originating company from parser metadata or cover page."},
        "asset_tags": {"column_type": "json_column", "is_calculated": true, "calculation": {"type": "cover_page_element", "field": "asset_tags"}, "processing_phase": "B", "validation": [{"type": "min_length", "min_length": 0}], "description": "Asset tag list extracted from cover page content, comma-split to JSON array."},
        "references_documents": {"column_type": "json_column", "is_calculated": false, "processing_phase": "B", "description": "Array of document IDs this document references, from content parser."},
        "language": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "description": "ISO 639-1 language code of document content. Default: en."},
        "vendor_name": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "description": "Equipment vendor name for vendor-supplied documents."},
        "total_sheets": {"column_type": "numeric_column", "is_calculated": true, "calculation": {"type": "priority_chain", "sources": [{"source": "parser_metadata", "field": "total_sheets"}, {"source": "parser_metadata", "field": "page_count"}], "fallback": "leave_null"}, "processing_phase": "B", "applies_to_document_types": ["DRAWING"], "description": "Total sheets in multi-sheet drawing set. I275 scoped to DRAWING concept (datasheets store per-row count, not total_sheets). Defaults to page_count when not explicit."},
        "lifecycle_stage": {"column_type": "code_column", "is_calculated": false, "processing_phase": "B", "schema_ref": "lifecycle_stage_code", "validation": [{"type": "enum_reference", "reference": "lifecycle_stage_code", "field": "code"}], "description": "Document lifecycle stage from cover page or parser metadata."},
        "revision_description": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "description": "Description of changes in this revision from revision table element."},
        "revision_date": {"column_type": "date_column", "is_calculated": false, "processing_phase": "B", "description": "Date of this revision from revision table or parser metadata."},
        "project_phase": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "description": "Project lifecycle phase from cover page or parser metadata."},
        "contract_package": {"column_type": "text_column", "is_calculated": false, "processing_phase": "B", "description": "Procurement contract package grouping from cover page or parser metadata."},
