{
  "$schema": "https://eks.engineering/schemas/eks_setup_schema.json",
  "$id": "https://eks.engineering/configs/eks_export_view_config.json",
  "version": "1.2.0",
  "title": "EKS Export View Configuration",
  "description": "Default export view values SSOT (I307 T1.278 / I308 T1.282 / I309 T1.289). v1.2.0 (I309): review_flags gains xlsx format — ALL 3 views are now Excel-eligible (Q3) so the single-workbook export writes one worksheet per view. Actual VALUES for the 3 default views (discovery_inventory, extraction_results, review_flags) per AGENTS.md \u00c2\u00a79/\u00c2\u00a716 (base/setup hold shape only). Each views[] entry declares view_id, source_table, ordered columns, file_base_name, sheet_name, and formats. Optional filter (column/value) drives the persistent view WHERE clause (is_latest = TRUE). view_id doubles as export_artifact.artifact_type (I306).",
  "views": [
    {
      "view_id": "discovery_inventory",
      "source_table": "documents",
      "filter": {
        "column": "is_latest",
        "value": true
      },
      "columns": [
        "project_title",
        "project_number",
        "area",
        "discipline",
        "department",
        "source_type",
        "document_type",
        "document_number",
        "revision",
        "status",
        "file_path",
        "file_type",
        "ingested_at",
        "created_by",
        "checked_by",
        "approved_by",
        "originator_company",
        "security_class",
        "asset_tags",
        "verified_by",
        "file_size",
        "file_created_at",
        "file_modified_at",
        "file_hash",
        "embedded_title",
        "embedded_subject",
        "embedded_created_date",
        "embedded_modified_date",
        "embedded_creator_app",
        "embedded_producer",
        "embedded_last_modified_by",
        "embedded_keywords",
        "embedded_sheet_count",
        "document_title",
        "lifecycle_stage",
        "revision_date",
        "revision_description",
        "embedded_revision_number",
        "references_documents",
        "project_phase",
        "contract_package",
        "issued_date",
        "responsible_engineer",
        "total_sheets",
        "language",
        "vendor_name"
      ],
      "file_base_name": "discovery_inventory",
      "sheet_name": "Discovery",
      "formats": [
        "csv",
        "xlsx"
      ]
    },
    {
      "view_id": "extraction_results",
      "source_table": "documents",
      "filter": {
        "column": "is_latest",
        "value": true
      },
      "columns": [
        "project_title",
        "project_number",
        "area",
        "discipline",
        "department",
        "source_type",
        "document_type",
        "document_number",
        "revision",
        "status",
        "file_path",
        "file_type",
        "ingested_at",
        "created_by",
        "checked_by",
        "approved_by",
        "originator_company",
        "security_class",
        "asset_tags",
        "page_count",
        "extract_status",
        "extraction_confidence",
        "extraction_notes",
        "verified_by",
        "file_size",
        "file_created_at",
        "file_modified_at",
        "file_hash",
        "embedded_title",
        "embedded_subject",
        "embedded_created_date",
        "embedded_modified_date",
        "embedded_creator_app",
        "embedded_producer",
        "embedded_last_modified_by",
        "embedded_keywords",
        "embedded_sheet_count",
        "document_title",
        "lifecycle_stage",
        "revision_date",
        "revision_description",
        "embedded_revision_number",
        "references_documents",
        "project_phase",
        "contract_package",
        "issued_date",
        "responsible_engineer",
        "total_sheets",
        "language",
        "vendor_name"
      ],
      "file_base_name": "extraction_results",
      "sheet_name": "Extraction",
      "formats": [
        "csv",
        "xlsx"
      ]
    },
    {
      "view_id": "review_flags",
      "source_table": "documents",
      "filter": {
        "column": "is_latest",
        "value": true
      },
      "columns": [
        "project_title",
        "project_number",
        "area",
        "discipline",
        "document_number",
        "revision",
        "document_type",
        "extract_status",
