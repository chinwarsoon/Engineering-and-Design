{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unified_graph_schema.json",
  "title": "UnifiedGraph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes", "edges", "entry_points", "hotspots", "stats"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "kind", "confidence", "source_of_truth"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "layer": { "enum": ["browser", "http", "java", "db", "external"] },
          "language": { "enum": ["javascript", "typescript", "java", "sql", null] },
          "kind": { "enum": ["function", "method", "class", "endpoint", "sql", "page", "component"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source_of_truth": { "enum": ["static", "runtime", "both"] },
          "span_count": { "type": "integer" },
          "total_duration_ms": { "type": "number" },
          "error_count": { "type": "integer" },
          "endpoints": { "type": "array", "items": { "type": "string" } },
          "file": { "type": "string" },
          "line": { "type": "integer" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "type", "confidence"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "type": {
            "enum": ["static_call", "dynamic_call", "http_call", "sql_call", "event_bind", "initiator", "correlation"]
          },
          "line": { "type": ["integer", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "metadata": { "type": "object" }
        }
      }
    },
    "entry_points": { "type": "array", "items": { "type": "string" } },
    "hotspots": { "type": "array", "items": { "type": "object" } },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules", "functions", "edges", "entry_points", "hotspots",
        "layers", "correlation_rate", "span_count", "trace_count"
      ],
      "properties": {
        "modules": { "type": "integer" },
        "functions": { "type": "integer" },
        "edges": { "type": "integer" },
        "entry_points": { "type": "integer" },
        "hotspots": { "type": "integer" },
        "layers": { "type": "object", "additionalProperties": { "type": "integer" } },
        "correlation_rate": { "type": "number" },
        "span_count": { "type": "integer" },
        "trace_count": { "type": "integer" }
      }
    }
  }
}
